// Ubicación: com.examen.model
package com.examen.model;

public class Student {
    // Atributos privados (Encapsulación)
    private int id; // Atributo mandatorio
    private String name;
    private String major;
    private double gpa;

    // Constructor
    public Student(int id, String name, String major, double gpa) {
        this.id = id;
        this.name = name;
        this.major = major;
        this.gpa = gpa;
    }

    // Getters y Setters (Acceso controlado)
    public int getId() { return id; }
    public String getName() { return name; }
    // ... (Otros getters/setters si fueran necesarios)

    // Sobrescritura de toString para mejor visualización
    @Override
    public String toString() {
        return "Student{" +
                "id=" + id +
                ", name='" + name + '\'' +
                ", major='" + major + '\'' +
                ", gpa=" + gpa +
                '}';
    }
}